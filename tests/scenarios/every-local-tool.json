{
 "name": "every-local-tool",
 "about": "Build tools on: list_dir, read_file with a line range, write_file of a new file, a parallel read-only batch (list_dir and read_file in one round), run_shell in the sandbox writing and reading a file. Covers tool results, the run_shell result shape and the ids kept in order.",
 "config": {
  "TOOLS_ENABLED": "1",
  "EXPLORE_ENABLED": "0",
  "SEARCH_ENABLED": "0",
  "CONSULT_ENABLED": "0",
  "CHAT_AUTO_TITLE": "0"
 },
 "max_model_len": 65536,
 "workspace": {
  "src/app.py": "line one\nline two\nline three\n",
  "README.md": "demo\n"
 },
 "steps": [
  {
   "user": "Look around, then make hello.txt."
  }
 ],
 "approvals": [],
 "responses": [
  {
   "expect": {
    "stream": false,
    "tools": "auto"
   },
   "message": ""
  },
  {
   "expect": {
    "stream": true,
    "tools": "auto"
   },
   "stream": [
    {
     "reasoning": "Start with the files."
    },
    {
     "tool_call": {
      "id": "c_list",
      "name": "list_dir",
      "arguments": "{\"path\": \".\"}"
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "expect": {
    "stream": true,
    "tools": "auto"
   },
   "stream": [
    {
     "tool_call": {
      "id": "c_read",
      "name": "read_file",
      "arguments": "{\"path\": \"src/app.py\", \"start_line\": 2, \"end_line\": 3}"
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "expect": {
    "stream": true,
    "tools": "auto"
   },
   "stream": [
    {
     "tool_call": {
      "id": "c_l2",
      "name": "list_dir",
      "arguments": "{\"path\": \"src\"}",
      "index": 0
     }
    },
    {
     "tool_call": {
      "id": "c_r2",
      "name": "read_file",
      "arguments": "{\"path\": \"README.md\"}",
      "index": 1
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "expect": {
    "stream": true,
    "tools": "auto"
   },
   "stream": [
    {
     "tool_call": {
      "id": "c_write",
      "name": "write_file",
      "arguments": "{\"path\": \"hello.txt\", \"content\": \"hello\\n\"}"
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "expect": {
    "stream": true,
    "tools": "auto"
   },
   "stream": [
    {
     "tool_call": {
      "id": "c_run",
      "name": "run_shell",
      "arguments": "{\"command\": \"cat hello.txt && echo made > out.txt && cat out.txt\"}"
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "expect": {
    "stream": true,
    "tools": "auto"
   },
   "stream": [
    {
     "content": "hello.txt holds hello; out.txt holds made."
    }
   ]
  }
 ]
}
